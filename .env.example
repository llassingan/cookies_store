# =============================================================================
# Maison Croûte (House of Crust) — Environment Configuration Template
# =============================================================================
#
# Copy this file to `.env` and fill in the values for your environment.
# The `.env` file is git-ignored and never committed — this template is
# the public reference for what keys exist and what they control.
#
# The configuration is divided into logical sections:
#
#   DATABASE + PORTS    — connection string and server ports
#   CORS + URLS         — which origins can talk to the API, public URLs
#   AUTH                — admin login credentials + JWT signing secret
#   PAYMENT             — payment gateway (mayar.id in prod, mock in dev)
#   EMAIL               — order confirmation emails (mock/smtp/resend)
#   SHOP CONFIG         — daily capacity, cutoff hour, queue rules
#
# Most values have sensible defaults for local development. The ones you
# MUST change before deploying to production are marked with "CHANGE ME"
# in their inline comments.
# =============================================================================

DATABASE_URL=postgres://postgres:password@127.0.0.1:5455/cookies

# ============================================================================
# Server ports (web=14022, api=14045). Override per environment.
# ============================================================================
API_PORT=14045
WEB_PORT=14022
HOSTNAME=0.0.0.0
NODE_ENV=development

# ============================================================================
# CORS allowlist — comma-separated list of origins (scheme + host + port).
# Wildcard `*` is supported in the host portion only and matches a single
# subdomain label (any chars except dots). To allow any subdomain of
# example.com use `https://*.example.com:14022`.
# ============================================================================
CORS_ORIGINS=http://localhost:14022,http://127.0.0.1:14022,https://*.your-domain.com:14022,https://*.your-domain.com
PUBLIC_BASE_URL=https://your-subdomain.your-domain.com:14022
WEB_API_URL=https://your-subdomain.your-domain.com:14045

# ============================================================================
# Auth
# ============================================================================
# CHANGE ME: Must be at least 32 bytes of random data for JWT signing.
AUTH_SECRET=replace-with-32-bytes-of-randomness
# CHANGE ME: Default admin credentials for the back-office.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ============================================================================
# Payment gateway (mayar.id) — mock in dev
# ============================================================================
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=mock-key
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret

# ============================================================================
# Email — mock in dev (writes to tmp/emails/)
# ============================================================================
EMAIL_PROVIDER=mock
EMAIL_FROM=orders@your-subdomain.your-domain.com

# ============================================================================
# Shop config
# ============================================================================
# IANA timezone for cutoff + bake-date math (default Asia/Jakarta).
SHOP_TIMEZONE=Asia/Jakarta
# Maximum cookies the bakery can produce in one day.
SHOP_DAILY_CAPACITY=20
# Orders placed after this hour (24h format) are scheduled for H+2.
SHOP_ORDER_CUTOFF_HOUR=17
# How many days ahead customers can book (default 3 = ~60 cookies max queue).
SHOP_MAX_QUEUE_DAYS=3
# Maximum orders a single customer can place per calendar day.
SHOP_MAX_ORDERS_PER_CUSTOMER_PER_DAY=5
