{
  "name": "@cookies/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:reset": "bun run src/db/reset.ts"
  },
  "dependencies": {
    "@cookies/shared": "workspace:*",
    "@hono/zod-validator": "0.4.1",
    "drizzle-orm": "0.36.4",
    "hono": "4.6.14",
    "postgres": "3.4.5",
    "zod": "3.24.1",
    "jose": "5.9.6",
    "bcryptjs": "2.4.3",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "bun-types": "1.1.42",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
